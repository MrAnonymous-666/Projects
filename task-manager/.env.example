# Copy this file to .env and fill in your real values
# Get a free MongoDB connection string at https://www.mongodb.com/cloud/atlas

MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager
JWT_SECRET=replace_this_with_a_long_random_string
PORT=5000

# For the "Forgot Password" OTP email feature.
# EMAIL_USER = your Gmail address
# EMAIL_PASS = a Gmail "App Password" (NOT your normal Gmail password)
# See README.md for how to generate an App Password.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_app_password
